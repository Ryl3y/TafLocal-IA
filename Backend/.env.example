# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (PostgreSQL). Pour un essai rapide sans PostgreSQL : DB_ENGINE=sqlite
DB_ENGINE=postgresql
DB_NAME=taflocal_ai
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery (optionnels)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT (minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# CORS : origines du frontend (Vite utilise le port 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Media
MEDIA_URL=/media/

# Moteur IA interne (aucune clé d'API nécessaire)
AI_MATCH_CACHE_TTL=3600
AI_INTERVIEW_QUESTIONS=6
AI_THROTTLE_RATE=60/min
AI_USE_CELERY=False
CV_MAX_UPLOAD_SIZE=5242880
