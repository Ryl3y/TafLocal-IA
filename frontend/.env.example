# L'API est appelée sur la MÊME origine que l'interface (/api) : indispensable pour les
# cookies de session HttpOnly + SameSite=Strict. Ne pas mettre une autre adresse ici.
VITE_API_BASE_URL=/api

# Adresse réelle du backend Django, utilisée par le proxy du serveur de développement Vite.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Adresse email publique affichée sur la page Contact (laisser vide pour la masquer).
VITE_CONTACT_EMAIL=
